/**
 * Starter password-reset page.
 *
 * Renders the `<ResetForm>` island (the `/api/password-reset` route answers
 * JSON, so the form needs a small client island). The confirm step
 * (`/api/password-reset/confirm`) is reached via the link in the reset email
 * and is handled by Better Auth.
 */

import type { RequestContext } from 'jsails';

import { Layout, loadLayout, type LayoutAssets } from '../ui/layout.js';
import { ResetForm } from '../ui/reset-password.js';

export interface ResetPageProps {
  assets?: LayoutAssets;
  path?: string;
}

export async function load(context: RequestContext): Promise<ResetPageProps> {
  return {
    assets: await loadLayout(context),
    path: context.url.pathname,
  };
}

export default function ResetPasswordPage({ assets, path }: ResetPageProps) {
  return (
    <Layout title="Reset password — JSails Starter" assets={assets} path={path}>
      <div class="mx-auto flex w-full max-w-md flex-col gap-6 py-6">
        <header class="flex flex-col items-center gap-3 text-center">
          <span class="brand-mark" aria-hidden="true">
            J
          </span>
          <h1 class="text-3xl font-bold tracking-tight">Reset password</h1>
          <p class="text-sm text-base-content/65">
            Enter your account email and we will send a reset link.
          </p>
        </header>

        <section class="card border border-base-300/70 bg-base-100 shadow-sm">
          <div class="card-body gap-5">
            <div data-jsails-island="reset-password">
              <ResetForm />
            </div>
          </div>
        </section>

        <p class="text-center text-sm text-base-content/55">
          <a class="link link-hover" href="/login">
            Back to sign in
          </a>
        </p>
      </div>
    </Layout>
  );
}
