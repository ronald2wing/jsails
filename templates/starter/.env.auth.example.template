# Example environment for the Better Auth starter (`jsails.app.js`).
#
# Copy these into your process environment (shell, ONCE, systemd) or load them
# yourself before starting the app. JSails does NOT auto-load a `.env` file:
# a file named `.env` is only read if your own tooling reads it.

# Required in production. Better Auth fails without a secret; JSails does not
# invent a fallback. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. MariaDB connection for Better Auth (the recommended default; start
# it with `jamal up`). Auth requires a database connection, and JSails reads
# these variables individually — there is no DATABASE_URL.
DATABASE_HOST=
#DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Optional. Public base URL of the app (default `http://localhost:3000`).
# Set this to the origin the browser actually uses, especially behind a
# TLS-terminating proxy, so Better Auth builds correct callback URLs.
#BETTER_AUTH_URL=http://localhost:3000
