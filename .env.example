# Development service credentials — copy to `.env` and fill in real values.
#
# `jamal up` interpolates these into the local database/Valkey containers; the
# app reads the same names. A connection URL is never used: set each field.

# Database (MariaDB is the default; use `postgres` for PostgreSQL)
DATABASE_TYPE=mariadb
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=jsails
DATABASE_PASSWORD=change-me
DATABASE_NAME=myapp
DATABASE_ROOT_PASSWORD=change-me

# Valkey / Redis
VALKEY_URL=redis://127.0.0.1:6379