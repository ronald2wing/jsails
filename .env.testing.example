# Test environment — overrides `.env` under `NODE_ENV=test` (set by
# `jsails test`). Copy to `.env.testing` and point DATABASE_NAME at the test
# database; `.env` is still loaded as the base, so only override what the test
# run must differ on.
#
# The convention follows the Node consensus (dotenv-flow, Vite, Next, Symfony):
# `.env.testing` layers on `.env` and overrides the keys it sets; `.env.local`
# is deliberately not loaded in test mode so tests are reproducible.

DATABASE_TYPE=mariadb
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=jsails
DATABASE_PASSWORD=change-me
DATABASE_NAME=myapp_test
DATABASE_ROOT_PASSWORD=change-me

VALKEY_URL=redis://127.0.0.1:6379