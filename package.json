{
  "name": "jsails",
  "version": "1.0.0",
  "private": false,
  "description": "TypeScript application framework: Active Record ORM with history migrations, filesystem pages and APIs, server components with soft navigation, plugins with an admin panel, and Jamal local/deploy tooling.",
