  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "build:clean": "npm run clean && npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:clean && node scripts/run-tests.mjs",
    "check-structure": "node scripts/check-src-structure.mjs",
    "check": "node scripts/run-parallel.mjs lint format:check check-structure && npm run test",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "pretest:watch": "tsc -p tsconfig.json",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --experimental-test-coverage",
    "verify:starter": "node scripts/verify-starter.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "website": "npm run build && npm --prefix website run build"
  },
