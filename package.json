    "create-jsails": "./dist/src/cli/create-jsails.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "pretest:watch": "tsc -p tsconfig.json",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --experimental-test-coverage",
    "verify:starter": "node scripts/verify-starter.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "website": "npm run build && npm --prefix website run build"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
